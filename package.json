{
  "name": "gauge-service",
  "version": "0.1.0",
  "description": "Weather and sensor monitoring backend — sensors, readings, alerts, weather proxy",
  "type": "module",
  "main": "dist/boot.js",
  "scripts": {
    "start": "node dist/boot.js",
    "dev": "tsx watch src/boot.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.ts\"",
    "format:check": "prettier --check \"**/*.ts\"",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "deploy": "bash deploy.sh",
    "deploy:dry": "bash deploy.sh --dry-run",
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@rodrigo-barraza/service-library": "git+https://github.com/rodrigo-barraza/service-library.git",
    "@rodrigo-barraza/utilities-library": "github:rodrigo-barraza/utilities-library",
    "express": "^5.2.1",
    "luxon": "^3.7.2",
    "mongodb": "^7.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.8.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.3",
    "tsx": "^4.22.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.33.0",
    "vitest": "^4.1.5"
  }
}
